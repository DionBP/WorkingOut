// Local Xcode development fallback values (not the GitHub deployment configuration).
// GitHub Actions sets these build settings using repository Variables.
// Replace these defaults as well when creating a different app, if building locally.
APP_DISPLAY_NAME = WorkingOut
APP_BUNDLE_IDENTIFIER = dk.haugaard.workingout
WATCH_APP_BUNDLE_IDENTIFIER = dk.haugaard.workingout.watchapp
WIDGET_BUNDLE_IDENTIFIER = dk.haugaard.workingout.widgets
WATCH_WIDGET_BUNDLE_IDENTIFIER = dk.haugaard.workingout.watchapp.widgets
ICLOUD_CONTAINER_IDENTIFIER = iCloud.dk.haugaard.workingout
