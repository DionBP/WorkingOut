    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut reads workouts and their available metrics to show your training history."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut læser træninger og deres tilgængelige målinger for at vise din træningshistorik."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut saves your recorded workouts in Apple Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut gemmer dine registrerede træninger i Apple Sundhed."
          }
        }
      }
    }
