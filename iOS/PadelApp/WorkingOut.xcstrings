    "garmin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin Connect"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin Connect"
          }
        }
      }
    },
    "garminGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Garmin Connect, enable Apple Health sharing and allow workouts. Sync your watch, open Garmin Connect, then refresh workouts here. Available distance and energy depend on what Garmin writes to Apple Health. Detailed sets, routes and heart rate may be unavailable. Choose one device to record each session."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå deling med Apple Sundhed til i Garmin Connect, og tillad træninger. Synkroniser uret, åbn Garmin Connect, og opdater derefter træninger her. Distance og energi afhænger af, hvad Garmin skriver til Apple Sundhed. Detaljerede sæt, ruter og puls kan mangle. Brug én enhed til at registrere hver træning."
          }
        }
      }
    },
    "gps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS recording"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS-registrering"
          }
        }
      }
    },
    "gpsDistance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS distance"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS-målt distance"
          }
        }
      }
    },
    "gpsGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut uses location during a run to measure distance, pace and route, including while the screen is locked."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut bruger din lokation under et løb til at måle distance, tempo og rute, også når skærmen er låst."
          }
        }
      }
    },
    "gpsPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location during runs"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad lokation under løb"
          }
        }
      }
    },
    "gpsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is unavailable. You can change access in Settings."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen adgang til lokation. Du kan ændre adgangen i Indstillinger."
          }
        }
      }
    },
    "gpsWaiting": {
