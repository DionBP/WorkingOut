    "healthGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health to read workouts and optionally save completed sessions. You can change access in the Health app."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind Apple Sundhed for at læse træninger og vælge, om gennemførte træninger skal gemmes. Du kan ændre adgangen i appen Sundhed."
