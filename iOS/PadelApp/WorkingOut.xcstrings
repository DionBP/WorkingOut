    "longestRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longest run"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Længste løbetur"
          }
        }
      }
    },
    "movement.bridge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press through your feet and lift your hips while keeping your ribs down. Lower under control."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pres gennem fødderne, og løft hofterne uden at løfte ribbenene. Sænk kontrolleret."
          }
        }
      }
    },
    "movement.carry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall with the load secure. Walk with short, steady steps and set the load down with control."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå oprejst med et sikkert greb. Gå med korte, jævne skridt, og sæt vægten kontrolleret ned."
          }
        }
      }
    },
    "movement.crunch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl your torso or pelvis toward your ribs without pulling on your neck. Return slowly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rul overkroppen eller bækkenet mod ribbenene uden at trække i nakken. Vend langsomt tilbage."
          }
        }
      }
    },
    "movement.curl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend the working joint smoothly, pause briefly, then lower without momentum."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj det arbejdende led jævnt, hold kort, og sænk uden at bruge fart."
          }
        }
      }
    },
    "movement.extend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the supporting joints steady. Straighten or move the working limb, then return under control."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold de støttende led stabile. Stræk eller før den arbejdende arm eller det arbejdende ben, og vend kontrolleret tilbage."
          }
        }
      }
    },
    "movement.fly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a soft bend in your elbows. Bring your arms together or apart in an arc, then reverse slowly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en let bøjning i albuerne. Før armene sammen eller fra hinanden i en bue, og vend langsomt tilbage."
          }
        }
      }
    },
    "movement.hinge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your trunk and move from your hips. Return by extending your hips without overextending your back."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spænd op i kroppen, og bevæg dig fra hofterne. Ret hofterne ud uden at svaje i ryggen."
          }
        }
      }
    },
    "movement.hold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your trunk, hold the position while breathing steadily, and stop when you lose alignment."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spænd op, og hold stillingen, mens du trækker vejret roligt. Stop, hvis du mister positionen."
          }
        }
      }
    },
    "movement.lunge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower with control while keeping your front foot grounded. Push through that foot to return."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sænk dig kontrolleret med forfoden plantet, og pres gennem foden for at komme op igen."
          }
        }
      }
    },
    "movement.press": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up with stable support. Press through a comfortable range, then return slowly without losing control."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find en stabil position. Pres i en behagelig bevægebane, og vend langsomt tilbage med kontrol."
          }
        }
      }
    },
    "movement.pull": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with controlled reach. Draw your elbows down, then return to the start without swinging."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med et kontrolleret stræk. Træk albuerne ned, og vend tilbage uden at svinge."
          }
        }
      }
    },
    "movement.raise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift through a controlled range and lower slowly. Keep the rest of your body steady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft i en kontrolleret bevægebane, og sænk langsomt. Hold resten af kroppen stabil."
          }
        }
      }
    },
    "movement.row": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your torso, pull toward you, then let your arms extend without jerking."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spænd op i overkroppen, træk mod dig, og stræk derefter armene uden ryk."
          }
        }
      }
    },
    "movement.squat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your torso, bend your hips and knees, then push back up while keeping your feet stable."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spænd op i overkroppen, bøj hofter og knæ, og pres op igen med fødderne stabilt placeret."
          }
        }
      }
    },
    "movement.stability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your trunk and move slowly. Keep your pelvis and rib cage steady throughout the exercise."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spænd op, og bevæg dig langsomt. Hold bækken og brystkasse stabile under hele øvelsen."
          }
        }
      }
    },
    "movement.step": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant your whole foot on a stable step. Drive through that foot, then step back down with control."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placér hele foden på et stabilt trin. Pres gennem foden, og træd kontrolleret ned igen."
          }
        }
      }
    },
