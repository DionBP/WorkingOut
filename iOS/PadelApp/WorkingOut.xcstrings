    "garmin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin Connect"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin Connect"
          }
        }
      }
    },
    "garminGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Apple Health, tap your profile photo, select Apps under Privacy, then select Connect and allow Workouts. Sync your watch with Garmin Connect open, then refresh here. Garmin does not share GPS routes through Apple Health, and workout distance, energy, and heart-rate details depend on the source. Record each session on one device."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på dit profilbillede i Apple Sundhed, vælg Apps under Anonymitet, vælg Connect, og tillad Træninger. Synkroniser uret med Garmin Connect åben, og opdater her. Garmin deler ikke GPS-ruter via Apple Sundhed. Oplysninger om distance, energi og puls afhænger af kilden. Registrér hver træning på én enhed."
          }
        }
      }
    },
    "gps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS recording"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS-registrering"
          }
        }
      }
    },
    "gpsDistance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS distance"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS-målt distance"
          }
        }
      }
    },
    "gpsGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut uses location during a run to measure distance, pace and route, including while the screen is locked."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkingOut bruger din lokation under et løb til at måle distance, tempo og rute, også når skærmen er låst."
          }
        }
      }
    },
    "gpsPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location during runs"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad lokation under løb"
          }
        }
      }
    },
    "gpsRecordDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastest time from the first GPS fix to each distance, with continuous GPS coverage."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigste tid fra første GPS-måling til hver distance med sammenhængende GPS-dækning."
          }
        }
      }
    },
